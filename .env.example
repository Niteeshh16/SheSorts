# Server
PORT=5000
NODE_ENV=development

# Database (Provide either DATABASE_URL or individual DB_* credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shesorts_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shesorts_db

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
